{
  "name": "coffee-runner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run test && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "smoke": "tsx scripts/smoke.ts",
    "render": "tsx scripts/render.ts",
    "test": "tsx scripts/smoke.ts && tsx scripts/render.ts && tsx scripts/ui.tsx",
    "ui": "tsx scripts/ui.tsx"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "5.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "4.1.17",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
